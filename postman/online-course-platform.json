              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Instructor\",\n  \"email\": \"instructor@example.com\",\n  \"password\": \"DemoPass123!\",\n  \"role\": \"instructor\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
